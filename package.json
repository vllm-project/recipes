{
  "name": "vllm-recipes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "node scripts/sync-sources.mjs && node scripts/assemble-content.mjs && next dev",
    "build": "node scripts/sync-sources.mjs && node scripts/build-recipes-api.mjs && node scripts/fetch-provider-logos.mjs && node scripts/fetch-hf-dates.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "content": "node scripts/sync-sources.mjs && node scripts/assemble-content.mjs",
    "content:watch": "node scripts/assemble-content.mjs --watch",
    "content:update": "node scripts/sync-sources.mjs --update",
    "test:smg-pd": "node --test scripts/test-smg-pd.mjs",
    "validate": "node --experimental-vm-modules hooks/validate.mjs",
    "test:overlay": "node --test scripts/test-overlay.mjs",
    "test:schema": "node --test scripts/test-schema.mjs",
    "test:guide-html": "node --test scripts/test-guide-html.mjs",
    "test:dcp": "node --test scripts/test-dcp-selector.mjs",
    "test:presets": "node --test scripts/test-presets.mjs",
    "test:context": "node --test scripts/test-context.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^2.0.1",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.483.0",
    "match-sorter": "^8.3.0",
    "next": "^15.5.22",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^15.5.9",
    "tailwindcss": "^4"
  }
}
